{
  "name": "juaniquillo/table-component-action",
  "description": "Table cell action/recipe components and table builders for backend tables.",
  "keywords": [
    "laravel",
    "table",
    "backend-components",
    "crud"
  ],
  "homepage": "https://github.com/juaniquillo/table-component-action",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Juaniquillo",
      "email": "juaniquillo@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/juaniquillo/table-component-action/issues",
    "source": "https://github.com/juaniquillo/table-component-action"
  },
  "require": {
    "php": "^8.3",
    "illuminate/database": "^11.0||^12.0||^13.0",
    "illuminate/support": "^11.0||^12.0||^13.0",
    "juaniquillo/crud-assistant": "^0.3.0",
    "juaniquillo/laravel-backend-component": "^0.12.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.15",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.3",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "rector/rector": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "Juaniquillo\\TableComponentAction\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Juaniquillo\\TableComponentAction\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Juaniquillo\\TableComponentAction\\TableComponentActionServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage",
    "lint": "vendor/bin/pint --parallel",
    "lint:check": "vendor/bin/pint --parallel --test",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
    "rector": "vendor/bin/rector process",
    "rector:check": "vendor/bin/rector process --dry-run",
    "qa": [
      "@analyse",
      "@rector:check",
      "@lint:check",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
